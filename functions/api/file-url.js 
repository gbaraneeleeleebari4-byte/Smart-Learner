

const BUCKET = 'my-first-bucket';

async function identifyUser(request, env) {
  const h = request.headers.get('Authorization') || '';
  if (!h.startsWith('Bearer ')) return null;

  const token = h.slice(7);

  const apiKey =
    env.FIREBASE_WEB_API_KEY ||
    'AIzaSyBalfqEksKXbrcfVCqrrWkILx_V7up25Xs';

  const r = await fetch(
    `https://identitytoolkit.googleapis.com/v1/accounts:lookup?key=${encodeURIComponent(apiKey)}`,
    {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ idToken: token })
    }
  );

  if (!r.ok) return null;

  const d = await r.json();
  const u = d.users?.[0];

  return u?.localId ? { uid: u.localId, token } : null;
}

function json(data, status = 200) {
  return Response.json(data, {
    status,
    headers: { 'Cache-Control': 'no-store' }
  });
}

export async function onRequestPost({ request, env }) {
  try {
    const user = await identifyUser(request, env);

    if (!user) {
      return json({ error: 'Authentication required.' }, 401);
    }

    if (!env.DBBYTE_API_KEY) {
      return json({ error: 'Storage is not configured.' }, 500);
    }

    const b = await request.json();
    const key = String(b.key || '');

    if (!key || key.includes('..') || key.startsWith('/')) {
      return json({ error: 'Invalid file key.' }, 400);
    }

    const groupId = String(b.groupId || '');

    if (key.startsWith('private/')) {
      if (!key.includes(`/${user.uid}/`)) {
        return json({
          error: 'You do not have access to this private file.'
        }, 403);
      }
    }

    if (key.startsWith('group/')) {
      if (!groupId) {
        return json({ error: 'Group context is required.' }, 400);
      }

      const db =
        env.FIREBASE_DATABASE_URL ||
        'https://smart-learn-hub-73667-default-rtdb.europe-west1.firebasedatabase.app';

      const mr = await fetch(
        `${db}/groups/${encodeURIComponent(groupId)}/members/${encodeURIComponent(user.uid)}.json?auth=${encodeURIComponent(user.token)}`
      );

      if (!mr.ok || !(await mr.json())) {
        return json({
          error: 'You are not a member of this group.'
        }, 403);
      }
    }

    const expiresIn = Math.min(
      Math.max(Number(b.expiresIn) || 3600, 60),
      604800
    );

    const signUrl =
      `https://api.dbbyte.com/storage/${BUCKET}/sign/` +
      key.split('/').map(encodeURIComponent).join('/');

    const r = await fetch(signUrl, {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${env.DBBYTE_API_KEY}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ expiresIn })
    });

    const responseText = await r.text();

    let d = {};
    try {
      d = JSON.parse(responseText);
    } catch {
      d = {};
    }

    if (!r.ok) {
      console.error('DBByte signing error:', r.status, responseText);

      return json({
        error: `DBByte signing failed (HTTP ${r.status}): ${d.error || responseText || 'Unknown error'}`
      }, r.status);
    }

    if (!d.url) {
      return json({
        error: 'DBByte responded, but did not return a signed URL.'
      }, 502);
    }

    return json({
      url: d.url,
      expiresIn
    });

  } catch (e) {
    console.error('File URL error:', e);

    return json({
      error: e.message || 'Unexpected file URL error.'
    }, 500);
  }
}
